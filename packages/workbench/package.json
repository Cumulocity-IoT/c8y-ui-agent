{
  "name": "@cumulocity-iot/c8y-ui-workbench",
  "version": "0.0.0-development",
  "type": "module",
  "description": "MCP server for the C8Y UI Agent: preview a Cumulocity Web SDK app on the emulated tenant and prove regressions with e2e runs.",
  "author": "Cumulocity GmbH",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulocity-IoT/c8y-ui-agent.git",
    "directory": "packages/workbench"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "reporter"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@cumulocity-iot/ui-sdk": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "c8y-ui-workbench": "./dist/cli.mjs"
  }
}
